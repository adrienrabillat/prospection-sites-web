# Copier ce fichier en .env puis remplir les valeurs.

# Anthropic : Claude juge les sites (payant à l'usage, plafonds dans config.yaml). Obligatoire.
ANTHROPIC_API_KEY=
# Seulement si la clé n'est rattachée à aucun espace de travail (l'outil te le dira) : wrkspc_…
ANTHROPIC_WORKSPACE_ID=

# SerpAPI (Google Maps) : 250 recherches gratuites par mois, une ville en consomme 46. Recommandé.
SERPAPI_KEY=

# E-mail de contact ajouté au User-Agent des appels aux services publics (facultatif)
CONTACT_EMAIL=
