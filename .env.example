# Copier ce fichier en .env puis remplir les valeurs. Toutes les clés sont optionnelles.

# E-mail de contact ajouté au User-Agent (recommandé par l'API de l'État)
CONTACT_EMAIL=

# SerpAPI (Google Maps) — plan gratuit : 250 recherches / mois
SERPAPI_KEY=

# Brave Search API — plus de plan gratuit illimité : 5 $ de crédit offert / mois (~1 000 requêtes), carte bancaire requise
BRAVE_API_KEY=

# Google PageSpeed Insights — gratuit avec une clé (Google Cloud Console)
PAGESPEED_API_KEY=

# Anthropic (agent IA de qualification, Claude Sonnet) — payant à l'usage, plafond mensuel dans config.yaml
ANTHROPIC_API_KEY=

# Pappers — payant (100 crédits offerts), non intégré pour l'instant
PAPPERS_API_KEY=
